# ===== StockFu · 配置示例 =====
# 复制为 .env 后按需修改；留空也可运行（用免费公开数据源）。

# 基础
APP_NAME=StockFu·资产管理终端
API_HOST=127.0.0.1
API_PORT=8787

# 存储（默认本地 SQLite）
DB_URL=sqlite:///data/stockfu.db

# 自选样本（首次 init-db 写入的种子资产，逗号分隔）
WATCHLIST=600519,000858,600036,601318,00700,09988,AAPL,MSFT,510300,510500

# ===== 数据源增强（可选）=====
TUSHARE_TOKEN=

# ===== AI 决策报告（可选）=====
# 兼容 OpenAI 协议；留空则 AI 报告功能降级为模板摘要
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ===== 消息推送（可选，后续接入）=====
# PUSH_WECHAT_WEBHOOK=

# 定时抓取（cron，默认工作日 18:18）
DAILY_CRON=18 18 * * 1-5

# 网络：港美股(yfinance)走代理；国内数据源直连。留空 PROXY_URL 则不走代理。
PROXY_URL=http://127.0.0.1:7890
PROXY_BYPASS=eastmoney.com,sina.com.cn,qq.com,cninfo.com.cn,localhost,127.0.0.1,local,.local
